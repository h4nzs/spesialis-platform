---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro'
import { ServiceList } from '../components/ServiceList.tsx'
import { createServerClient } from '@ahlipanggilan/shared'

const apiUrl = process.env.API_URL ?? process.env.PUBLIC_API_URL ?? 'http://localhost:3000'
const api = createServerClient('', '', apiUrl)

interface ServiceItem {
  id: string
  name: string
  slug: string
}

let services: ServiceItem[] = []

try {
  const result = await api.get<ServiceItem[]>('/api/v1/services?limit=100')
  services = result.data ?? []
} catch {}
---

<BaseLayout
  title="Layanan - Ahli Panggilan"
  description="Pilih layanan jasa profesional yang Anda butuhkan — AC, plumbing, listrik, cleaning, CCTV, dan lainnya. Harga transparan, teknisi berpengalaman."
  canonicalUrl="/services"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://ahlipanggilan.id' },
          { '@type': 'ListItem', position: 2, name: 'Layanan' },
        ],
      },
      {
        '@type': 'ItemList',
        itemListElement: services.map((s, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          url: `https://ahlipanggilan.id/services/${s.slug}`,
          name: s.name,
        })),
      },
    ],
  }}
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <nav class="mb-8 text-body-sm text-text-secondary">
      <a href="/" class="hover:text-text-primary transition-colors">Beranda</a>
      <span class="mx-2">/</span>
      <span class="text-text-primary">Layanan</span>
    </nav>

    <h1 class="text-h2 font-bold text-text-primary">Layanan</h1>
    <p class="mt-2 text-text-secondary">Pilih layanan yang Anda butuhkan</p>

    <div class="mt-8">
      <ServiceList client:idle searchQuery={Astro.url.searchParams.get('q') ?? undefined} />
    </div>
  </div>
</BaseLayout>
