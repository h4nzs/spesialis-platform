# Environment bersama untuk script security host-level.
# Salin ke /etc/security/webhook.env (chmod 600, root) di VPS.
#
# SECURITY_WEBHOOK_URL: endpoint alert gateway di API (default sudah benar).
# SECURITY_WEBHOOK_SECRET: sama dengan SECURITY_WEBHOOK_SECRET di .env.prod
#   API — script mengirim alert lewat jalur yang sama dengan CrowdSec.
SECURITY_WEBHOOK_URL=https://ahlipanggilan.id/api/v1/security/webhook
SECURITY_WEBHOOK_SECRET=GANTI_DENGAN_SECRET_DARI_ENV_PROD
