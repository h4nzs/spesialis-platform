<clickhouse>
    <!--
      Memory limit config for ClickHouse in Docker.
      
      Docker cgroup limit: 1GB (1024MB)
      max_server_memory_usage: 900MB — leaves ~124MB headroom for:
        - Background merge operations
        - Temporary allocations during query processing
        - System caches (mark cache, uncompressed cache)
      
      Upped from 650MB/768MB because the TrafficChangeNotifier spike
      detection query needs ~1.34 GiB to complete. 900MB is the max
      we can allocate before hitting Docker cgroup limit.
      
      listen_try: 1 — prevents startup failure if a listen address
      cannot be bound (e.g., IPv6 disabled on VPS).
    -->
    <max_server_memory_usage>943718400</max_server_memory_usage>
    <listen_try>1</listen_try>
</clickhouse>
