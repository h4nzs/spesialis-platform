diff --git a/packages/database/migrations/0029_audit_log_immutable.sql b/packages/database/migrations/0029_audit_log_immutable.sql
new file mode 100644
index 0000000..5dc8d20
--- /dev/null
+++ b/packages/database/migrations/0029_audit_log_immutable.sql
@@ -0,0 +1,24 @@
+-- Make audit_logs immutable (append-only)
+-- Prevents UPDATE and DELETE on audit_logs table to enforce
+-- tamper-evident audit trail integrity.
+--
+-- Security: DB-level enforcement (not just application-level).
+
+CREATE OR REPLACE FUNCTION prevent_audit_mutation()
+RETURNS TRIGGER AS $$
+BEGIN
+  RAISE EXCEPTION 'audit_logs is append-only — UPDATE and DELETE are not allowed';
+END;
+$$ LANGUAGE plpgsql;
+
+DROP TRIGGER IF EXISTS audit_no_update ON audit_logs;
+CREATE TRIGGER audit_no_update
+  BEFORE UPDATE ON audit_logs
+  FOR EACH ROW
+  EXECUTE FUNCTION prevent_audit_mutation();
+
+DROP TRIGGER IF EXISTS audit_no_delete ON audit_logs;
+CREATE TRIGGER audit_no_delete
+  BEFORE DELETE ON audit_logs
+  FOR EACH ROW
+  EXECUTE FUNCTION prevent_audit_mutation();
diff --git a/packages/database/migrations/0030_updated_at_triggers.sql b/packages/database/migrations/0030_updated_at_triggers.sql
